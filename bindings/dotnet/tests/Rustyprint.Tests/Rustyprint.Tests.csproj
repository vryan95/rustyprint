<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The oldest .NET the package supports, and the newest. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Runs the net8.0 tests on a newer runtime when .NET 8 is not installed. -->
    <RollForward>Major</RollForward>
    <NoWarn>$(NoWarn);CA1707;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Rustyprint/Rustyprint.csproj" />
  </ItemGroup>

</Project>
